#!/sbin/openrc-run

APP_NAME="www-gay-leggy-dev"
APP_USER="uncertainty"
APP_CMD="/home/uncertainty/www/gay_leggy_dev/www"

command="${APP_CMD}"
command_args="-secret=balls -last-fm=balls -files-dir=files -address=127.0.0.1 -port=3000"
command_user="${APP_USER}"
command_background=true
pidfile="/var/run/${APP_NAME}.pid"
output_log="/var/log/${APP_NAME}.log"
error_log="/var/log/${APP_NAME}_error.log"

depend() {
    need net
}

start_pre() {
    checkpath --owner=$command_user --mode 600 --file $output_log
    checkpath --owner=$command_user --mode 600 --file $error_log
}
